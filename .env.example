# ─────────────────────────────────────────────────────────────────────
# Yuno — single-command stack env template
#
# Quick start:
#     cp .env.example .env
#     # fill in the REQUIRED keys below
#     docker compose up --build
#
# Everything not marked REQUIRED has a working default suitable for a
# laptop / hiring demo.
# ─────────────────────────────────────────────────────────────────────

APP_NAME="Agent Orchestrator"
ENVIRONMENT=local

# ── App secrets ───────────────────────────────────────────────────────
# REQUIRED. Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<paste-32+-char-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# These are overridden by docker-compose to use container service names.
# Leave as-is if you ever want to run the api/worker on the host instead.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:3002/agent_orchestrator
REDIS_URL=redis://localhost:3003/0

CORS_ORIGINS=http://localhost:3000

LOG_HTTP_BODIES=false
LOG_MAX_BODY_BYTES=4096

# ── Telegram (only required if you want the Telegram demo) ────────────
# Generate a bot token via @BotFather. Set the webhook URL to your
# publicly reachable api endpoint:
#     curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-host>/api/v1/channels/telegram/webhook&secret_token=<SECRET_BELOW>"
TELEGRAM_WEBHOOK_SECRET=<random-opaque-string>
# Set AFTER seeding a workflow — the GitHub Concierge seed auto-fills this.
TELEGRAM_WORKFLOW_ID=
# Set when seeding — same demo workspace your account lands in after signup.
TELEGRAM_WORKSPACE_ID=

# ── Memory (mem0 — routed through OpenRouter) ─────────────────────────
# REQUIRED if any agent uses long-term memory. Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY_MEMORY=<paste-sk-or-...>
# Optional: pick any OpenRouter model id. Default = openai/gpt-4o-mini.
# MEM0_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Neo4j (graph memory). docker-compose overrides these to point at the
# in-stack neo4j container; leave as-is for a single-machine deploy.
NEO4J_URL=bolt://localhost:3005
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentpass

MEMORY_DEFAULT_HISTORY_TURNS=10
MEMORY_DEFAULT_RECALL_K=5
