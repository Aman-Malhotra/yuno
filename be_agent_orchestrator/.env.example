APP_NAME="Agent Orchestrator"
ENVIRONMENT=local

# Host defaults. docker-compose overrides these with `postgres`/`redis`
# service names via the `environment:` block on api + worker.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:3002/agent_orchestrator
REDIS_URL=redis://localhost:3003/0

# REQUIRED. Generate locally: `uv run python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Must be ≥32 bytes. Never commit a real value — this file is the template only.
JWT_SECRET_KEY=<generate-with-secrets.token_urlsafe-48>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dev-only: log request + response bodies on every call (truncated, auth header redacted)
LOG_HTTP_BODIES=false
LOG_MAX_BODY_BYTES=4096

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
